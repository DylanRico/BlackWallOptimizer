{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blackwall",
  "version": "1.0.0",
  "identifier": "com.blackwall.optimizer",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:3847"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Blackwall — Muro Negro",
        "width": 1380,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "center": true,
        "maximized": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
