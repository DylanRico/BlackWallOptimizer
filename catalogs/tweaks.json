      ],
      "riskLevel": "low",
      "riskWarning": null,
      "deviceScope": ["desktop"],
      "osCompatibility": ["win10", "win11"],
      "tags": ["desktop", "usb", "pcie", "latencia", "ratón", "gpu", "nvme"],
