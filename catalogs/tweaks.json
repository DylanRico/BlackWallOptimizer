    {
      "id": "laptop_modern_standby_network",
      "category": "optimization",
      "subcategory": "Energía y Batería (Laptop)",
      "title": "Desactivar Red en Modern Standby (S0 Low Power Idle) en Batería",
      "description": "Impide que Windows mantenga la conexión Wi-Fi activa mientras la laptop tiene la tapa cerrada en batería, evitando drenaje nocturno y sobrecalentamiento en mochilas.",
      "benefits": [
        "Reduce hasta un 85% la pérdida de batería en modo suspensión",
        "Previene que la laptop se caliente guardada en la mochila"
      ],
      "riskLevel": "low",
      "riskWarning": null,
      "deviceScope": ["laptop"],
      "osCompatibility": ["win10", "win11"],
      "tags": ["laptop", "batería", "modern standby", "suspensión", "calor", "energía", "s0"],
      "applyOps": [
        { "type": "reg_dword", "hive": "HKLM", "key": "SOFTWARE\\Policies\\Microsoft\\Power\\PowerSettings\\f15576e8-98b7-4186-b944-eafa664402d9", "name": "DCSettingIndex", "value": 0 },
        { "type": "powercfg", "args": "/setdcvalueindex scheme_current sub_none f15576e8-98b7-4186-b944-eafa664402d9 0" },
        { "type": "powercfg", "args": "/setactive scheme_current" }
      ],
      "undoOps": [
        { "type": "reg_delete", "hive": "HKLM", "key": "SOFTWARE\\Policies\\Microsoft\\Power\\PowerSettings\\f15576e8-98b7-4186-b944-eafa664402d9", "name": "DCSettingIndex" },
        { "type": "powercfg", "args": "/setdcvalueindex scheme_current sub_none f15576e8-98b7-4186-b944-eafa664402d9 1" },
        { "type": "powercfg", "args": "/setactive scheme_current" }
      ]
    },
