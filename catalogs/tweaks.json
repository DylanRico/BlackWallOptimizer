    {
      "id": "laptop_hibernation_fast_boot",
      "category": "optimization",
      "subcategory": "Energía y Batería (Laptop)",
      "title": "Hibernación Compacta (Hiberfil Reducido al 40%)",
      "description": "Mantiene activa la hibernación para proteger tus documentos si se agota la batería, pero comprime el archivo hiberfil.sys al 40% de la RAM.",
      "benefits": [
        "Recupera entre 6 GB y 16 GB de espacio en el SSD NVMe",
        "Conserva la hibernación segura ante batería crítica"
      ],
      "riskLevel": "low",
      "riskWarning": null,
      "deviceScope": ["laptop"],
      "osCompatibility": ["win10", "win11"],
      "tags": ["hibernación", "ssd", "espacio", "laptop", "hiberfil"],
      "applyOps": [
        { "type": "powercfg", "args": "/hibernate on" },
        { "type": "powercfg", "args": "/hibernate /size 40" }
      ],
      "undoOps": [
        { "type": "powercfg", "args": "/hibernate /size 100" }
      ]
    },
